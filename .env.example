# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# Optional. Leave blank for research/scanning/replay/learning without broker access.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ── DeepSeek (optional — LLM signals, co-pilot, agents) ───────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Anthropic Claude (optional — dual-LLM validation layer) ──────────────────
ANTHROPIC_API_KEY=

# ── OpenAI (optional — semantic news embeddings via Qdrant) ──────────────────
# Without this key, news search falls back to keyword matching (still works).
OPENAI_API_KEY=

# ── Marketaux (optional — AI-tagged, sentiment-scored stock news) ─────────────
# Free tier: 100 requests/day. One call covers up to 25 tickers.
# Get a key from Marketaux only if you want this provider.
MARKETAUX_API_KEY=

# ── Telegram Push Notifications ──────────────────────────────────────────────
# Optional. If configured: create a bot, then supply its token and your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading Universe ──────────────────────────────────────────────────────────
UNIVERSE=RELIANCE,INFY,TCS,HDFCBANK,ICICIBANK

# ── Risk Limits ───────────────────────────────────────────────────────────────
MAX_CAPITAL_EXPOSURE=0.20
MAX_POSITION_SIZE_PCT=0.10
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.02
MIN_SIGNAL_CONFIDENCE=0.60

# ── Agent Supervisor (optional — runs parallel multi-agent cross-validation) ──
ENABLE_AGENT_SUPERVISOR=false

# ── Engine ────────────────────────────────────────────────────────────────────
CYCLE_INTERVAL_SECONDS=300
EXCHANGE=NSE
PRODUCT_TYPE=MIS

# ── Paper Trading ─────────────────────────────────────────────────────────────
# true = all orders go to paper journal, never to Kite. false = live execution.
SQ_PAPER_TRADING=true
# Local default stays interactive when valid Kite credentials exist. Set 1 on a
# cloud/unattended machine to skip the daily login prompt; non-broker autonomy
# continues either way.
QT_NONINTERACTIVE=0

# ── Logging ───────────────────────────────────────────────────────────────────
# Directory for structured logs and SQLite stores (created automatically).
LOG_DIR=logs
