# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=generated_each_morning_via_python_main.py_login

# ── DeepSeek (required for LLM signals, co-pilot, agents) ────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Anthropic Claude (optional — dual-LLM validation layer) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (optional — semantic news embeddings via Qdrant) ──────────────────
# Without this key, news search falls back to keyword matching (still works)
OPENAI_API_KEY=sk-...

# ── Marketaux (optional — AI-tagged, sentiment-scored stock news) ─────────────
# Free tier: 100 requests/day. One call covers up to 25 tickers.
# Get key at: https://www.marketaux.com
MARKETAUX_API_KEY=your_marketaux_key_here

# ── Telegram Push Notifications ──────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → get TELEGRAM_BOT_TOKEN
# 2. Send any message to your bot, then fetch chat_id:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Trading Universe ──────────────────────────────────────────────────────────
UNIVERSE=RELIANCE,INFY,TCS,HDFCBANK,ICICIBANK

# ── Risk Limits ───────────────────────────────────────────────────────────────
MAX_CAPITAL_EXPOSURE=0.20
MAX_POSITION_SIZE_PCT=0.10
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.02
MIN_SIGNAL_CONFIDENCE=0.60

# ── Agent Supervisor (optional — runs parallel multi-agent cross-validation) ──
ENABLE_AGENT_SUPERVISOR=false

# ── Engine ────────────────────────────────────────────────────────────────────
CYCLE_INTERVAL_SECONDS=300
EXCHANGE=NSE
PRODUCT_TYPE=MIS

# ── Suggestion quality gates (scanner + sniper) ───────────────────────────────
# RSI must not be greater than 70 before a stock is suggested.
# QT_RSI_OVERBOUGHT_SOFT=70
# QT_RSI_OVERBOUGHT_HARD=70
# QT_SNIPER_RSI_BLOWOFF=70
# Skip names fallen more than 50% from 52-week high (floor 40%).
# QT_MAX_DROP_FROM_HIGH=0.50

# ── Paper Trading ─────────────────────────────────────────────────────────────
# true = all orders go to paper journal, never to Kite. false = live execution.
SQ_PAPER_TRADING=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Directory for structured logs and SQLite stores (created automatically).
LOG_DIR=logs
