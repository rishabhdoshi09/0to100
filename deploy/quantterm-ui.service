# Template only. deploy/setup_server.sh installs an absolute-path unit.
[Unit]
Description=QuantTerm retail UI (read-only control room)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/streamlit run app.py --server.port 8501 --server.headless true
Restart=on-failure
[Install]
WantedBy=multi-user.target
