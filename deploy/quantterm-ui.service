# Template only. deploy/setup_server.sh installs an absolute-path unit.
[Unit]
Description=QuantTerm desk (Vite :5173 + API :8765)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=__APP_DIR__
Environment=PYTHONPATH=__APP_DIR__
ExecStart=/bin/bash __APP_DIR__/scripts/run_quantterm.sh
Restart=on-failure
[Install]
WantedBy=multi-user.target
